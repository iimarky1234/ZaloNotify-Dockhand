# Docker network that your Dockhand container is attached to.
# Find it with:
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}} {{end}}' <dockhand-container>
DOCKHAND_NETWORK=dockhand_default

# Pin a tested tag (caronc/apprise:2.1.0 ships Apprise 2.2.0 with the native zalo:// plugin).
APPRISE_IMAGE=caronc/apprise:2.1.0

# Container timezone and host UID/GID for ./apprise file permissions.
TZ=Asia/Ho_Chi_Minh
PUID=1000
PGID=1000

# Zalo Bot Token (used by zalo-watcher sidecar and scripts/get-chat-id.sh).
# Can also be read from apprise/dockhand.yml if already configured there.
ZALO_BOT_TOKEN=

# How zalo-watcher authorizes new chats to receive Dockhand notifications:
#   Option A (recommended): Set a secret passcode; users send `/subscribe <passcode>`
#     (or `@BotName /subscribe <passcode>` in a group chat).
ZALO_SUBSCRIBE_PASSCODE=change-me-secret

#   Option B: Set ZALO_AUTO_SUBSCRIBE=true to auto-add ANY chat/group that messages
#     or @mentions the bot without a passcode (only use if your bot is private).
ZALO_AUTO_SUBSCRIBE=false

# Long-polling timeout (seconds) and confirmation replies for zalo-watcher.
ZALO_POLL_TIMEOUT=25
ZALO_SEND_WELCOME=true
